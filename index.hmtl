/* =========================================================
   FOOD ESTIMATOR
   ========================================================= */
ui.est={mode:"single",food:"chickpeas",amt:"",unit:"g",oil:"light",oilG:"",nf:{},pot:{name:"",rows:[{food:"chickpeas_dry",g:""},{food:"onion",g:""},{food:"tomato",g:""}],oil:"",total:"",portion:"",servings:"",eaten:""}};
function allFoods(){return settings().customFoods.map(f=>Object.assign({group:"My foods and recipes",units:[],note:""},f)).concat(FOODS)}
function foodById(id){return allFoods().find(f=>f.id===id)||null}
function foodOptions(sel){
  const groups={};allFoods().forEach(f=>{(groups[f.group]=groups[f.group]||[]).push(f)});
  return Object.keys(groups).map(g=>`<optgroup label="${esc(g)}">${groups[g].map(f=>`<option value="${esc(f.id)}" ${f.id===sel?"selected":""}>${esc(f.name)}</option>`).join("")}</optgroup>`).join("");
}
function oilFor(grams,mode,custom){return mode==="light"?grams/200*5:mode==="oily"?grams/200*10:mode==="custom"?(num(custom)||0):0}
function nutr(f,grams){const k=grams/100;return {cal:f.cal*k,p:f.p*k,c:f.c*k,f:f.f*k,fib:f.fib==null?null:f.fib*k}}
function addN(a,b){return {cal:a.cal+b.cal,p:a.p+b.p,c:a.c+b.c,f:a.f+b.f,fib:(a.fib==null&&b.fib==null)?null:(a.fib||0)+(b.fib||0)}}
function scaleN(a,k){return {cal:a.cal*k,p:a.p*k,c:a.c*k,f:a.f*k,fib:a.fib==null?null:a.fib*k}}
function nLine(n){return `<b>${comma(n.cal)}</b> cal · ${Math.round(n.p)} P · ${Math.round(n.c)} C · ${Math.round(n.f)} F${n.fib!=null?" · "+Math.round(n.fib)+" fiber":""}`}
function estSingle(){
  const e=ui.est, f=foodById(e.food); if(!f) return null;
  const amt=num(e.amt); if(amt==null||amt<=0) return {f,grams:null};
  const u=f.units.find(x=>x[0]===e.unit), grams=u?amt*u[1]:amt;
  const oilG=oilFor(grams,e.oil,e.oilG);
  let n=nutr(f,grams); if(oilG) n=addN(n,{cal:oilG*8.84,p:0,c:0,f:oilG,fib:0});
  return {f,grams,oilG,n};
}
function estPot(){
  const P=ui.est.pot; let n={cal:0,p:0,c:0,f:0,fib:0}, any=false, weight=0;
  P.rows.forEach(r=>{const f=foodById(r.food), g=num(r.g); if(f&&g>0){n=addN(n,nutr(f,g));any=true;weight+=g}});
  const oil=num(P.oil)||0; if(oil){n=addN(n,{cal:oil*8.84,p:0,c:0,f:oil,fib:0});any=true}
  let frac=null, how="";
  const total=num(P.total), portion=num(P.portion), sv=num(P.servings), eaten=num(P.eaten);
  if(total>0&&portion>0){frac=portion/total;how=`${comma(portion)} g of a ${comma(total)} g pot`}
  else if(sv>0&&eaten>0){frac=eaten/sv;how=`${eaten} of ${sv} servings`}
  return {any,n,frac,how,total,oil};
}
function estimatorHtml(){
  const e=ui.est, f=foodById(e.food)||FOODS[0];
  const modeSeg=`<div class="seg mini">${[["single","One food"],["pot","Whole pot"]].map(m=>`<button type="button" data-act="est-mode" data-v="${m[0]}" aria-pressed="${e.mode===m[0]}">${m[1]}</button>`).join("")}</div>`;
  if(e.mode==="single"){
    const units=(f.servingOnly?[]:[["g","grams"]]).concat(f.units.map(u=>[u[0],u[0]]));
    return `${modeSeg}
    <div class="fld"><label>Food</label><select class="inp" data-est="food">${foodOptions(f.id)}</select></div>
    ${f.note?`<p class="hint">${esc(f.note)}</p>`:""}
    <div class="grid2"><div class="fld"><label>Amount</label><input class="inp" data-est="amt" type="number" inputmode="decimal" placeholder="${e.unit==="g"?"grams on the scale":"how many"}" value="${esc(e.amt)}"></div>
      <div class="fld"><label>Unit</label><select class="inp" data-est="unit">${units.map(u=>`<option value="${esc(u[0])}" ${e.unit===u[0]?"selected":""}>${esc(u[1])}</option>`).join("")}</select></div></div>
    <div class="${e.oil==="custom"?"grid2":""}"><div class="fld"><label>Cooking oil or ghee in it</label><select class="inp" data-est="oil">
      ${[["none","None or already counted"],["light","Normal curry or dal (5 g per 200 g)"],["oily","Visibly oily (10 g per 200 g)"],["custom","I know the grams"]].map(o=>`<option value="${o[0]}" ${e.oil===o[0]?"selected":""}>${o[1]}</option>`).join("")}</select></div>
      ${e.oil==="custom"?`<div class="fld"><label>Oil (g)</label><input class="inp" data-est="oilG" type="number" inputmode="decimal" placeholder="1 tsp = 5 g" value="${esc(e.oilG)}"></div>`:""}</div>
    <div class="estout" data-live="est"></div>
    <button class="btn full" data-act="est-add">Add to today</button>
    <p class="hint">Weigh cooked food on the plate. Beans and lentils here are plain and boiled; the oil setting covers the tadka or curry base, using the guide's rule (Section 17).</p>
    <details class="nf"><summary>Add your own food from a label</summary>
      ${field("Name","n:name",e.nf.name||"",{type:"text",ph:"e.g. Nanak paneer"})}
      <p class="hint">Per 100 g. Label says per 28 g? Multiply by 3.57.</p>
      <div class="grid3">${field("Cal","n:cal",e.nf.cal)}${field("Protein","n:p",e.nf.p)}${field("Carbs","n:c",e.nf.c)}${field("Fat","n:f",e.nf.f)}${field("Fiber","n:fib",e.nf.fib)}</div>
      <button class="btn ghost full" data-act="est-save-food">Save to My foods</button></details>`;
  }
  const P=e.pot;
  return `${modeSeg}
    <p class="hint">For dal, chana, rajma, or any family dish: enter what went into the pot, then how much of it you ate. Dry dal is most accurate: ask how many grams or cups went in (1 cup dry dal ≈ 190 g).</p>
    ${field("Dish name","p:name",P.name,{type:"text",ph:"e.g. Mom's chana masala"})}
    <label class="lab">Ingredients (grams)</label>
    <div class="potrows">${P.rows.map((r,k)=>`<div class="potrow"><select class="inp" data-est="pot.rows.${k}.food">${foodOptions(r.food)}</select><input class="inp" data-est="pot.rows.${k}.g" type="number" inputmode="decimal" placeholder="g" value="${esc(r.g)}"><button class="ib" data-act="pot-del" data-i="${k}" aria-label="Remove ingredient">✕</button></div>`).join("")}</div>
    <button class="btn ghost full" data-act="pot-row">Add ingredient</button>
    ${field("Oil or ghee in the pot (g)","p:oil",P.oil,{ph:"1 tbsp ≈ 14 g"})}
    <label class="lab">Your share: weigh the pot, or count servings</label>
    <div class="grid2">${field("Cooked pot weight (g)","p:total",P.total,{ph:"minus the pot"})}${field("Your portion (g)","p:portion",P.portion)}</div>
    <div class="grid2">${field("…or servings in pot","p:servings",P.servings)}${field("Servings you ate","p:eaten",P.eaten,{step:"0.5"})}</div>
    <div class="estout" data-live="pot"></div>
    <div class="grid2"><button class="btn" data-act="pot-add">Add my portion</button><button class="btn ghost" data-act="pot-save">Save as recipe</button></div>
    <p class="hint">A saved recipe shows up under My foods, so next time you just weigh your plate.</p>`;
}
live.est=function(){const r=estSingle();if(!r)return "";if(r.grams==null)return `<span class="muted">Per 100 g: ${nLine(r.f)}</span>`;return `${comma(r.grams)} g${r.oilG?` + ${r1(r.oilG)} g oil`:""} ≈ ${nLine(r.n)}`};
live.pot=function(){const r=estPot();if(!r.any)return `<span class="muted">Add ingredient weights to see the totals.</span>`;return `Whole pot: ${nLine(r.n)}`+(r.frac!=null?`<br>Your share (${esc(r.how)}): ${nLine(scaleN(r.n,r.frac))}`:`<br><span class="muted">Add the pot weight and your portion (or servings) to get your share.</span>`)};
function setPath(obj,path,v){const p=path.split(".");let o=obj;for(let k=0;k<p.length-1;k++)o=o[p[k]];o[p[p.length-1]]=v}
function rerenderEst(){const b=document.getElementById("estbox");if(b){b.innerHTML=estimatorHtml();refreshLive()}}

/* =========================================================
   THEME
   ========================================================= */
function themePrefs(){let t={};try{t=JSON.parse(localStorage.getItem(LS_THEME)||"{}")||{}}catch(e){}const s=docs.settings||{};return {mode:t.mode||s.themeMode||"auto",palette:t.palette||s.palette||"moss"}}
function applyTheme(){
  const t=themePrefs(), r=document.documentElement;
  if(t.mode==="auto") r.removeAttribute("data-theme"); else r.setAttribute("data-theme",t.mode);
  r.setAttribute("data-palette",t.palette);
}
function setTheme(k,v){let t={};try{t=JSON.parse(localStorage.getItem(LS_THEME)||"{}")||{}}catch(e){}t[k]=v;try{localStorage.setItem(LS_THEME,JSON.stringify(t))}catch(e){}mutSettings(s=>{s[k==="mode"?"themeMode":"palette"]=v});applyTheme()}

/* =========================================================
   EVENTS
   ========================================================= */
function toast(msg){const t=document.getElementById("toast");t.textContent=msg;t.classList.add("show");clearTimeout(toast.t);toast.t=setTimeout(()=>t.classList.remove("show"),1900)}
document.querySelector("nav.tabs").addEventListener("click",e=>{const b=e.target.closest("button[data-tab]");if(!b)return;if(ui.tab===b.dataset.tab){window.scrollTo(0,0)}ui.tab=b.dataset.tab;render();window.scrollTo(0,0)});

function addFood(entry){mutDay(ui.iso,d=>{d.meals.push(entry)});render()}
function entryFrom(name,n){return {id:uid(),name,cal:Math.round(n.cal),p:Math.round(n.p*10)/10,c:Math.round(n.c*10)/10,f:Math.round(n.f*10)/10,fib:n.fib==null?null:Math.round(n.fib*10)/10}}
app.addEventListener("click",e=>{
  const a=e.target.closest("a[href^='#']");
  if(a&&app.contains(a)){e.preventDefault();const t=document.getElementById(a.getAttribute("href").slice(1));if(t)t.scrollIntoView({block:"start"});return}
  const b=e.target.closest("[data-act]"); if(!b||!app.contains(b)) return;
  const act=b.dataset.act, v=b.dataset.v, iso=ui.iso, i=idxOf(iso);
  switch(act){
    case "prev": ui.iso=isoOf(i-1); render(); break;
    case "next": ui.iso=isoOf(i+1); render(); break;
    case "today": ui.iso=todayIso(); render(); break;
    case "goto-day": ui.iso=b.dataset.iso; if(b.dataset.tab) ui.tab=b.dataset.tab; render(); if(b.dataset.tab) window.scrollTo(0,0); break;
    case "go-tab": ui.tab=v; render(); window.scrollTo(0,0); break;
    case "go-prog": ui.tab="progress"; ui.prog=v; render(); window.scrollTo(0,0); break;
    case "type": mutDay(iso,d=>{d.type=v}); render(); break;
    case "setv": {
      const bind=b.dataset.bind, kind=b.dataset.kind, val=kind==="text"?v:Number(v), parts=bind.split(":");
      if(parts[0]==="d") mutDay(iso,d=>{d[parts[1]]=d[parts[1]]===val?null:val});
      render(); break;}
    case "fluid": mutDay(iso,d=>{d.fluids=Math.max(0,(d.fluids||0)+Number(v))}); refreshLive(); {const el=app.querySelector('[data-live="fluids"]');if(el)el.classList.add("pulse")} break;
    case "add-food": {
      const g=id=>document.getElementById(id);
      const name=g("f-name").value.trim(), cal=num(g("f-cal").value), p=num(g("f-p").value), c=num(g("f-c").value), f=num(g("f-f").value), fib=num(g("f-fib").value);
      if(cal==null&&p==null){toast("Enter calories or protein first");g("f-cal").focus();return}
      addFood({id:uid(),name:name||"Food",cal,p,c,f,fib}); toast("Added"); break;}
    case "del-food": mutDay(iso,d=>{d.meals.splice(Number(b.dataset.i),1)}); render(); break;
    case "fav": {const m=getDay(iso).meals[Number(b.dataset.i)]; if(!m)break;
      mutSettings(s=>{s.favorites=Array.isArray(s.favorites)?s.favorites:[];const k=s.favorites.findIndex(f=>f.name===m.name&&f.cal===m.cal&&f.p===m.p);if(k>=0)s.favorites.splice(k,1);else s.favorites.push({name:m.name,cal:m.cal,p:m.p,c:m.c,f:m.f,fib:m.fib})});
      render(); break;}
    case "add-fav": {const f=settings().favorites[Number(b.dataset.i)]; if(f){addFood(Object.assign({id:uid()},f));toast("Added "+f.name)} break;}
    case "unfav": mutSettings(s=>{s.favorites=(s.favorites||[]).slice();s.favorites.splice(Number(b.dataset.i),1)}); render(); break;
    case "add-plan": {
      const tg=targetFor(i,getDay(iso)); const m=variantMeals(tg.key,tg.eff)[Number(b.dataset.m)]; const o=m&&m.opts[Number(b.dataset.o)]; if(!o)break;
      addFood({id:uid(),name:m.meal+(m.opts.length>1?" "+(b.dataset.o==="1"?"B":"A"):"")+": "+o.name,cal:o.total[0],p:o.total[1],c:o.total[2],f:o.total[3],fib:null}); toast("Added "+m.meal); break;}
    case "session": mutDay(iso,d=>{d.session=d.session===v?null:v}); render(); break;
    case "log-rest": mutDay(iso,d=>{d.logRest=true;d.session="done"}); render(); break;
    case "add-set": mutDay(iso,d=>{d.sets.push({lift:"",sets:null,reps:null,load:null})}); render(); {const ins=app.querySelectorAll(".setrow .lift");if(ins.length)ins[ins.length-1].focus()} break;
    case "del-set": mutDay(iso,d=>{d.sets.splice(Number(b.dataset.i),1)}); render(); break;
    case "copy-sets": {const k=lastSessionWithSets(i); if(k==null)break; const src=getDay(isoOf(k)).sets.filter(s=>s&&s.lift); mutDay(iso,d=>{d.sets=d.sets.concat(clone(src))}); render(); toast("Copied from "+fmtShort(k)); break;}
    case "prog": ui.prog=v; render(); break;
    case "plan": ui.plan=v; render(); break;
    case "ck-prev": ui.ckWeek=Math.max(0,ui.ckWeek-1); render(); break;
    case "ck-next": ui.ckWeek=Math.min(24,ui.ckWeek+1); render(); break;
    case "ck-goto": ui.ckWeek=Number(b.dataset.w); ui.tab="progress"; ui.prog="checkin"; render(); window.scrollTo(0,0); break;
    case "decide": mutWeek(ui.ckWeek,d=>{d.decision=v||null}); render(); if(v) toast("Decision saved"); break;
    case "lock-maint": {const w=Number(b.dataset.w); mutSettings(s=>{s.maintLock=s.maintLock===w?null:w}); render(); break;}
    case "show-measure": mutWeek(Number(b.dataset.w),d=>{d.showMeasure=true}); render(); break;
    case "pw-prev": ui.planWeek=Math.max(0,ui.planWeek-1); render(); break;
    case "pw-next": ui.planWeek=Math.min(24,ui.planWeek+1); render(); break;
    case "pw-goto": ui.planWeek=Number(b.dataset.w); ui.plan="week"; render(); window.scrollTo(0,0); break;
    case "mealtype": ui.mealType=v; render(); break;
    case "guide-to": ui.guideTarget=v; if(ui.tab!=="guide"){ui.tab="guide";render()}else{const t=document.getElementById(v);if(t)t.scrollIntoView({block:"start"});const det=app.querySelector("details.toc");if(det)det.open=false} break;
    case "theme-mode": setTheme("mode",v); render(); break;
    case "palette": setTheme("palette",v); render(); break;
    case "export": {
      const txt=JSON.stringify(docs);
      const fallback=()=>{const box=document.getElementById("importbox");box.hidden=false;const ta=document.getElementById("importtext");ta.value=txt;ta.focus();ta.select();toast("Select all and copy this text")};
      if(navigator.clipboard&&navigator.clipboard.writeText) navigator.clipboard.writeText(txt).then(()=>toast("Backup copied. Paste it into Notes to keep it."),fallback); else fallback();
      break;}
    case "import-show": {const box=document.getElementById("importbox");box.hidden=false;const ta=document.getElementById("importtext");ta.value="";ta.focus();break;}
    case "import": {
      let obj; try{obj=JSON.parse(document.getElementById("importtext").value)}catch(err){toast("That text isn't a valid backup");return}
      if(!obj||typeof obj!=="object"||Array.isArray(obj)){toast("That text isn't a valid backup");return}
      let n=0; Object.keys(obj).forEach(k=>{if(!/^(day-\d{4}-\d{2}-\d{2}|week-\d+|settings|final)$/.test(k)||typeof obj[k]!=="object"||!obj[k])return;docs[k]=Object.assign({},obj[k],{updatedAt:Date.now()});if(col){const key=k;setTimeout(()=>push(key),n*150)}n++});
      persistLocal(); projCache=null; applyTheme(); render(); toast("Restored "+n+" entries"); break;}
    case "download-csv": downloadCsv(); break;
    case "est-mode": ui.est.mode=v; rerenderEst(); break;
    case "est-add": {const r=estSingle(); if(!r||r.grams==null){toast("Enter an amount first");break}
      const nm=r.f.name.split(",")[0].split(" (")[0]+` ${comma(r.grams)} g`+(r.oilG?` + ${r1(r.oilG)} g oil`:"");
      addFood(entryFrom(nm,r.n)); toast("Added "+nm); ui.est.amt=""; break;}
    case "est-save-food": {const nf=ui.est.nf, name=(nf.name||"").trim(), cal=num(nf.cal);
      if(!name||cal==null){toast("Add a name and calories per 100 g");break}
      const id="c"+uid(); mutSettings(s=>{s.customFoods=(s.customFoods||[]).concat([{id,name,cal,p:num(nf.p)||0,c:num(nf.c)||0,f:num(nf.f)||0,fib:num(nf.fib),units:[],note:"Your food, per 100 g"}])});
      ui.est.nf={}; ui.est.food=id; ui.est.unit="g"; render(); toast("Saved "+name); break;}
    case "pot-row": ui.est.pot.rows.push({food:"veg",g:""}); rerenderEst(); break;
    case "pot-del": ui.est.pot.rows.splice(Number(b.dataset.i),1); rerenderEst(); break;
    case "pot-add": {const r=estPot(); if(!r.any){toast("Add ingredient weights first");break} if(r.frac==null){toast("Add the pot weight and your portion, or servings");break}
      addFood(entryFrom((ui.est.pot.name||"Home-cooked dish")+" ("+r.how+")",scaleN(r.n,r.frac))); toast("Added your portion"); break;}
    case "pot-save": {const r=estPot(), P=ui.est.pot, name=(P.name||"").trim(); if(!r.any){toast("Add ingredient weights first");break} if(!name){toast("Give the dish a name");break}
      const total=num(P.total), sv=num(P.servings); let food;
      if(total>0){const k=100/total;food={id:"r"+uid(),name,cal:Math.round(r.n.cal*k),p:r1(r.n.p*k)*1,c:r1(r.n.c*k)*1,f:r1(r.n.f*k)*1,fib:r.n.fib==null?null:r1(r.n.fib*k)*1,units:[],note:"Your recipe, per 100 g cooked"}}
      else if(sv>0){const k=1/sv;food={id:"r"+uid(),name,cal:Math.round(r.n.cal*k),p:r1(r.n.p*k)*1,c:r1(r.n.c*k)*1,f:r1(r.n.f*k)*1,fib:r.n.fib==null?null:r1(r.n.fib*k)*1,units:[["serving",100]],servingOnly:true,note:"Your recipe, per serving (enter servings, not grams)"}}
      else {toast("Add the cooked pot weight or number of servings");break}
      mutSettings(s=>{s.customFoods=(s.customFoods||[]).concat([food])}); toast("Saved "+name+" to My foods"); rerenderEst(); break;}
    case "del-custom": mutSettings(s=>{s.customFoods=(s.customFoods||[]).filter(f=>f.id!==v)}); render(); break;
    case "ov-reset": {const w=b.dataset.w; mutSettings(s=>{s.overrides=Object.assign({},s.overrides||{});delete s.overrides[w]}); render(); break;}
    case "ov-reset-all": if(window.confirm("Reset every week's calories to the plan?")){mutSettings(s=>{s.overrides={}}); render(); toast("Back to the plan")} break;
    case "bulk-set": case "bulk-shift": {
      const vals={train:num(document.getElementById("bk-train").value),rest:num(document.getElementById("bk-rest").value),refeed:num(document.getElementById("bk-refeed").value)};
      if(vals.train==null&&vals.rest==null&&vals.refeed==null){toast("Enter at least one number");break}
      const from=clamp(ui.bulkFrom||Math.max(currentWeek(),1),1,24), to=Math.max(from,ui.bulkTo||20);
      const plans={};for(let w=from;w<=to;w++)plans[w]=weekTargets(w).plan;
      mutSettings(s=>{s.overrides=Object.assign({},s.overrides||{});for(let w=from;w<=to;w++){const o=Object.assign({},s.overrides[w]||{});
        ["train","rest","refeed"].forEach(k=>{if(vals[k]==null)return;if(act==="bulk-set")o[k]=vals[k];else if(plans[w][k]!=null)o[k]=plans[w][k]+vals[k]});
        s.overrides[w]=o}});
      render(); toast((act==="bulk-set"?"Set":"Shifted")+` Weeks ${from}–${to}`); break;}
  }
});
function onInput(e){
  const t=e.target;
  if(t.dataset&&t.dataset.est){setPath(ui.est,t.dataset.est,t.value);
    if(e.type==="change"&&t.tagName==="SELECT"){if(t.dataset.est==="food"){ui.est.unit="g";const f=foodById(t.value);if(f&&f.servingOnly)ui.est.unit="serving";ui.est.oil=f&&(f.group==="Beans, lentils, dal"||f.group==="Vegetables")&&f.id!=="salad"&&f.id!=="hummus"&&f.id!=="onion"&&f.id!=="tomato"?"light":"none"}rerenderEst()} else refreshLive();
    return}
  if(t.dataset&&t.dataset.actChange){const v=Number(t.value);if(t.dataset.actChange==="bulk-from")ui.bulkFrom=v;else ui.bulkTo=v;return}
  const bind=t.dataset&&t.dataset.bind; if(!bind) return;
  const parts=bind.split(":");
  let v;
  if(t.type==="checkbox") v=t.checked;
  else if(t.type==="number") v=num(t.value);
  else v=t.value;
  if(parts[0]==="d") mutDay(ui.iso,d=>{d[parts[1]]=v});
  else if(parts[0]==="set"){const k=Number(parts[1]);mutDay(ui.iso,d=>{if(d.sets[k])d.sets[k][parts[2]]=v})}
  else if(parts[0]==="w"){const w=t.dataset.week!=null?Number(t.dataset.week):ui.ckWeek;mutWeek(w,d=>{d[parts[1]]=v;if(parts[1].indexOf("photo")===0)delete d.photos})}
  else if(parts[0]==="s") mutSettings(s=>{s[parts[1]]=v});
  else if(parts[0]==="f") mutFinal(d=>{d[parts[1]]=v});
  else if(parts[0]==="t") mutSettings(s=>{s.targets=Object.assign({},s.targets||{});if(v==null)delete s.targets[parts[1]];else s.targets[parts[1]]=v});
  else if(parts[0]==="o"){const w=parts[1],k=parts[2];mutSettings(s=>{s.overrides=Object.assign({},s.overrides||{});const o=Object.assign({},s.overrides[w]||{});if(v==null)delete o[k];else o[k]=v;if(Object.keys(o).length)s.overrides[w]=o;else delete s.overrides[w]})}
  else if(parts[0]==="k"){mutSettings(s=>{s.track=Object.assign({},TRACKDEF,s.track||{});s.track[parts[1]]=v});render();return}
  else if(parts[0]==="n"){ui.est.nf[parts[1]]=t.value;return}
  else if(parts[0]==="p"){ui.est.pot[parts[1]]=t.value}
  refreshLive();
}
app.addEventListener("input",e=>{if(e.target.type==="checkbox")return;onInput(e)});
app.addEventListener("change",e=>{if(e.target.type==="checkbox"||e.target.tagName==="SELECT"){onInput(e);if(e.target.type==="checkbox"&&e.target.dataset.bind&&e.target.dataset.bind.indexOf("d:")===0)refreshLive()}});
app.addEventListener("focusout",()=>{setTimeout(()=>{if(pendingRender)scheduleRender()},50)});
app.addEventListener("keydown",e=>{if(e.key==="Enter"&&e.target.id&&e.target.id.indexOf("f-")===0){e.preventDefault();const btn=app.querySelector('[data-act="add-food"]');if(btn)btn.click()}});
app.addEventListener("toggle",e=>{if(e.target.classList&&e.target.classList.contains("toc"))ui.guideOpen=e.target.open;if(e.target.dataset&&e.target.dataset.det==="est")ui.estOpen=e.target.open},true);

/* CSV */
function csvCell(v){v=v==null?"":String(v);return /[",\n]/.test(v)?'"'+v.replace(/"/g,'""')+'"':v}
function downloadCsv(){
  if(!downloadsApi) return;
  const head=["date","week","type","target_cal","weight","cal","protein","carbs","fat","fiber","fluids_oz","steps","sleep_h","energy","hunger","digestion","session","rpe","knee","workout","score","lifts","notes"];
  const lines=[head.join(",")];
  Object.keys(docs).filter(k=>k.indexOf("day-")===0).sort().forEach(k=>{
    const iso=k.slice(4), i=idxOf(iso), d=getDay(iso), t=totals(d), tg=targetFor(i,d);
    lines.push([iso,weekOf(i),tg.type,tg.cal,d.weight,t.cal||"",t.p||"",t.c||"",t.f||"",t.anyFib?t.fib:"",d.fluids,d.steps,sleepHours(d)!=null?r1(sleepHours(d)):"",d.energy,d.hunger,d.digestion,d.session,d.rpe,d.knee,d.wodName,d.wodScore,d.sets.filter(s=>s.lift).map(s=>s.lift+" "+(s.sets||"")+"x"+(s.reps||"")+"@"+(s.load||"")).join("; "),d.notes].map(csvCell).join(","));
  });
  downloadsApi.save({filename:"20-week-log.csv",data:lines.join("\n")}).then(()=>toast("Saved"),()=>toast("Download cancelled"));
}

/* =========================================================
   SYNC
   ========================================================= */
function onSnap(snap){
  const seen=new Set(), toPush=[];
  snap.docs.forEach(ds=>{
    seen.add(ds.id); const data=ds.data(); if(!data) return;
    if(timers[ds.id]) return;
    const local=docs[ds.id];
    if(!local||(data.updatedAt||0)>=(local.updatedAt||0)) docs[ds.id]=clone(data); else toPush.push(ds.id);
  });
  if(firstSync&&!snap.metadata.fromCache){firstSync=false;Object.keys(docs).forEach(k=>{if(!seen.has(k))toPush.push(k)})}
  toPush.forEach((k,j)=>{timers[k]=setTimeout(()=>push(k),200+j*150)});
  persistLocal(); projCache=null;
  syncMode="cloud"; applyTheme();
  scheduleRender();
}
(async function initSync(){
  try{
    if(!window.claude||typeof window.claude.use!=="function") return;
    const res=await Promise.all([window.claude.use("db"),window.claude.use("user"),window.claude.use("downloads").catch(()=>null)]);
    const db=res[0], user=res[1]; downloadsApi=res[2]||null;
    if(downloadsApi&&ui.tab==="plan"&&ui.plan==="settings") scheduleRender();
    if(!db||!user) return;
    const id=await user.id(); if(!id) return;
    col=db.collection("data/users/"+id);
    col.onSnapshot(onSnap,()=>{goLocal()});
  }catch(e){col=null}
})();

applyTheme();
render();
let lastToday=todayIso();
document.addEventListener("visibilitychange",()=>{if(document.visibilityState!=="visible")return;const t=todayIso();if(t!==lastToday){if(ui.iso===lastToday)ui.iso=t;lastToday=t;scheduleRender()}});
})();

</script>
</body>
</html>
