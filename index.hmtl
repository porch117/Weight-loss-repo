<!doctype html>
<html lang="en" data-palette="moss">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="20-Week Log">
<title>20-Week Log</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;600;700;800&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&display=swap" rel="stylesheet">
<script>(function(){try{var t=JSON.parse(localStorage.getItem("rishi-20wk-theme")||"{}");var r=document.documentElement;if(t.palette)r.setAttribute("data-palette",t.palette);if(t.mode&&t.mode!=="auto")r.setAttribute("data-theme",t.mode);}catch(e){}})();</script>
<style>
:root{--bg:#ECE6D9;--surface:#F8F4EC;--surface2:#F0EADF;--ink:#29251E;--muted:#6A6052;--line:#D6CCBA;--soft:#E4DCCC;--primary:#56663A;--onp:#F8F4EC;--good:#56663A;--bad:#A4552F;--hi:#B08125;--band:rgba(86,102,58,.16)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#161411;--surface:#201D18;--surface2:#28241E;--ink:#ECE4D6;--muted:#A3978A;--line:#3A342B;--soft:#2D2922;--primary:#A8B878;--onp:#171511;--good:#A8B878;--bad:#E08F69;--hi:#D9AF5C;--band:rgba(168,184,120,.16)}}
:root[data-theme="dark"]{--bg:#161411;--surface:#201D18;--surface2:#28241E;--ink:#ECE4D6;--muted:#A3978A;--line:#3A342B;--soft:#2D2922;--primary:#A8B878;--onp:#171511;--good:#A8B878;--bad:#E08F69;--hi:#D9AF5C;--band:rgba(168,184,120,.16)}
:root[data-palette="moss"]{--bg:#ECE6D9;--surface:#F8F4EC;--surface2:#F0EADF;--ink:#29251E;--muted:#6A6052;--line:#D6CCBA;--soft:#E4DCCC;--primary:#56663A;--onp:#F8F4EC;--good:#56663A;--bad:#A4552F;--hi:#B08125;--band:rgba(86,102,58,.16)}
@media (prefers-color-scheme:dark){:root[data-palette="moss"]:not([data-theme="light"]){--bg:#161411;--surface:#201D18;--surface2:#28241E;--ink:#ECE4D6;--muted:#A3978A;--line:#3A342B;--soft:#2D2922;--primary:#A8B878;--onp:#171511;--good:#A8B878;--bad:#E08F69;--hi:#D9AF5C;--band:rgba(168,184,120,.16)}}
:root[data-palette="moss"][data-theme="dark"]{--bg:#161411;--surface:#201D18;--surface2:#28241E;--ink:#ECE4D6;--muted:#A3978A;--line:#3A342B;--soft:#2D2922;--primary:#A8B878;--onp:#171511;--good:#A8B878;--bad:#E08F69;--hi:#D9AF5C;--band:rgba(168,184,120,.16)}
:root[data-palette="clay"]{--bg:#EFE4D8;--surface:#FAF4ED;--surface2:#F3EADF;--ink:#2E231C;--muted:#735F4E;--line:#DDCBB9;--soft:#E9DACA;--primary:#9A4A2A;--onp:#FAF4ED;--good:#5B7044;--bad:#8E2F22;--hi:#B08125;--band:rgba(154,74,42,.14)}
@media (prefers-color-scheme:dark){:root[data-palette="clay"]:not([data-theme="light"]){--bg:#181311;--surface:#231C18;--surface2:#2B221D;--ink:#EEE2D6;--muted:#A99585;--line:#3D322B;--soft:#302720;--primary:#E0966F;--onp:#1A1310;--good:#A9BD86;--bad:#EC8272;--hi:#D9AF5C;--band:rgba(224,150,111,.15)}}
:root[data-palette="clay"][data-theme="dark"]{--bg:#181311;--surface:#231C18;--surface2:#2B221D;--ink:#EEE2D6;--muted:#A99585;--line:#3D322B;--soft:#302720;--primary:#E0966F;--onp:#1A1310;--good:#A9BD86;--bad:#EC8272;--hi:#D9AF5C;--band:rgba(224,150,111,.15)}
:root[data-palette="stone"]{--bg:#E7E4DC;--surface:#F5F3EE;--surface2:#ECE9E1;--ink:#262826;--muted:#626660;--line:#CFCCC2;--soft:#DEDBD1;--primary:#4A625E;--onp:#F5F3EE;--good:#5A6D3D;--bad:#A2532F;--hi:#A67E2E;--band:rgba(74,98,94,.15)}
@media (prefers-color-scheme:dark){:root[data-palette="stone"]:not([data-theme="light"]){--bg:#141615;--surface:#1D201F;--surface2:#252927;--ink:#E6E7E2;--muted:#9CA29C;--line:#343936;--soft:#2A2E2C;--primary:#94B4AE;--onp:#121413;--good:#A8B878;--bad:#E08F69;--hi:#D6B062;--band:rgba(148,180,174,.15)}}
:root[data-palette="stone"][data-theme="dark"]{--bg:#141615;--surface:#1D201F;--surface2:#252927;--ink:#E6E7E2;--muted:#9CA29C;--line:#343936;--soft:#2A2E2C;--primary:#94B4AE;--onp:#121413;--good:#A8B878;--bad:#E08F69;--hi:#D6B062;--band:rgba(148,180,174,.15)}
:root[data-palette="cedar"]{--bg:#EAE2D5;--surface:#F7F1E8;--surface2:#EFE7DB;--ink:#2B211A;--muted:#6F5C4B;--line:#D8C8B5;--soft:#E5D7C5;--primary:#77492A;--onp:#F7F1E8;--good:#5C6C38;--bad:#A3402B;--hi:#B08125;--band:rgba(119,73,42,.14)}
@media (prefers-color-scheme:dark){:root[data-palette="cedar"]:not([data-theme="light"]){--bg:#17120F;--surface:#221B16;--surface2:#2A221C;--ink:#EFE3D4;--muted:#A89684;--line:#3C3129;--soft:#2F261F;--primary:#D6A574;--onp:#18120E;--good:#A8B878;--bad:#E5826B;--hi:#DDB25E;--band:rgba(214,165,116,.15)}}
:root[data-palette="cedar"][data-theme="dark"]{--bg:#17120F;--surface:#221B16;--surface2:#2A221C;--ink:#EFE3D4;--muted:#A89684;--line:#3C3129;--soft:#2F261F;--primary:#D6A574;--onp:#18120E;--good:#A8B878;--bad:#E5826B;--hi:#DDB25E;--band:rgba(214,165,116,.15)}
.pal-moss i:nth-child(1){background:#56663A}.pal-moss i:nth-child(2){background:#A4552F}.pal-moss i:nth-child(3){background:#ECE6D9}
.pal-clay i:nth-child(1){background:#9A4A2A}.pal-clay i:nth-child(2){background:#5B7044}.pal-clay i:nth-child(3){background:#EFE4D8}
.pal-stone i:nth-child(1){background:#4A625E}.pal-stone i:nth-child(2){background:#A2532F}.pal-stone i:nth-child(3){background:#E7E4DC}
.pal-cedar i:nth-child(1){background:#77492A}.pal-cedar i:nth-child(2){background:#A3402B}.pal-cedar i:nth-child(3){background:#EAE2D5}
:root{
  --sans:"Libre Franklin",-apple-system,"Helvetica Neue",Arial,sans-serif;
  --serif:"Literata",Georgia,"Times New Roman",serif;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  color-scheme:light;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark}}
:root[data-theme="dark"]{color-scheme:dark}
*,*::before,*::after{box-sizing:border-box}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 12px);-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.45 var(--sans);font-variant-numeric:tabular-nums;-webkit-font-smoothing:antialiased}
button,input,textarea,select{font:inherit;color:inherit}
button{cursor:pointer}
#app{max-width:600px;margin:0 auto;padding:10px 14px 120px}
h1,h2,h3{margin:0;line-height:1.2}
p{margin:0 0 .6em}
.muted{color:var(--muted)} .small{font-size:14px} .center{text-align:center}
.good{color:var(--good)} .bad{color:var(--bad)}
.hint{font-size:13.5px;color:var(--muted);margin:6px 0 8px}
.hint.warn{color:var(--bad)}
.linkbtn{background:none;border:0;padding:0;color:var(--primary);text-decoration:underline;text-underline-offset:2px;font-size:inherit}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:2px solid var(--primary);outline-offset:2px}

/* header / nav */
.pagehead{display:flex;align-items:center;justify-content:space-between;margin:6px 2px 12px}
.pagehead h1{font-size:28px;font-weight:700;letter-spacing:-.01em}
.dnav{display:flex;align-items:center;gap:8px;margin:4px 0 10px}
.dmid{flex:1;text-align:center;min-width:0}
.dtitle{font-size:24px;font-weight:700;letter-spacing:-.01em}
.dsub{font-size:14px;color:var(--muted)}
.dline{display:flex;justify-content:center;gap:14px;align-items:center;margin:-6px 0 12px;min-height:22px}
.arrow{width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:var(--surface);font-size:22px;line-height:1;flex:none}
.arrow:disabled{opacity:.35;cursor:default}
.sync{display:inline-flex;align-items:center;gap:5px;font-size:12.5px;color:var(--muted)}
.sync i{width:7px;height:7px;border-radius:50%;background:var(--muted)}
.sync.on i{background:var(--good)}

/* hero */
.hero{background:var(--primary);color:var(--onp);border-radius:18px;padding:16px 18px 14px;margin-bottom:12px}
.hero.small{padding:12px 16px}
.plan-line{font-size:14px;font-weight:600;opacity:.92}
.target{display:flex;align-items:baseline;flex-wrap:wrap;gap:4px 8px;margin-top:4px}
.target .big{font-size:52px;font-weight:800;letter-spacing:-.02em;line-height:1}
.target .tunit{font-size:18px;font-weight:700;opacity:.85}
.target .tlabel{flex-basis:100%;font-size:14px;opacity:.9}
.subtarget{font-size:13px;opacity:.85;margin-top:6px}

.banner{background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--bad);border-radius:6px 12px 12px 6px;padding:10px 12px;margin:0 0 10px;font-size:14.5px}
.banner.calm{border-left-color:var(--primary)}
details.notes{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:10px 12px;margin-bottom:12px;font-size:14.5px}
details.notes summary{font-weight:600;cursor:pointer}
details.notes ul{margin:8px 0 0;padding-left:18px}
details.notes li{margin:4px 0}

/* segmented */
.seg{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;background:var(--surface2);border:1px solid var(--line);border-radius:12px;padding:3px;margin:0 0 12px;gap:2px}
.seg button{border:0;background:none;padding:10px 4px;border-radius:9px;font-weight:600;font-size:14px;color:var(--muted);min-height:40px}
.seg button[aria-pressed="true"]{background:var(--primary);color:var(--onp)}

/* cards */
.card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:14px;margin-bottom:12px}
.card h2{font-size:16px;font-weight:700;margin-bottom:8px}
.card h2 .small{font-weight:400}
.lab,.fld label{display:block;font-size:13px;color:var(--muted);margin:10px 0 5px}
.fld label{margin-top:4px}
.inp{width:100%;min-width:0;max-width:100%;text-overflow:ellipsis;min-height:44px;padding:10px 11px;border:1px solid var(--line);border-radius:10px;background:var(--bg);font-size:16px}
textarea.inp{resize:vertical;line-height:1.4}
select.inp{appearance:none;-webkit-appearance:none;background-image:linear-gradient(45deg,transparent 50%,var(--muted) 50%),linear-gradient(135deg,var(--muted) 50%,transparent 50%);background-position:calc(100% - 16px) 50%,calc(100% - 11px) 50%;background-size:5px 5px;background-repeat:no-repeat;padding-right:28px}
input[type="time"].inp,input[type="date"].inp{-webkit-appearance:none;appearance:none;display:block}
.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.fld{min-width:0}
.btn{min-height:44px;padding:10px 16px;border-radius:11px;border:0;background:var(--primary);color:var(--onp);font-weight:700}
.btn.ghost{background:none;border:1px solid var(--line);color:var(--ink);font-weight:600}
.btn.full{width:100%;margin-top:8px}
.chiprow{display:flex;gap:6px;flex-wrap:wrap}
.chip{border:1px solid var(--line);background:var(--bg);border-radius:999px;padding:8px 13px;font-size:14px;min-height:38px;min-width:40px}
.chip[aria-pressed="true"]{background:var(--primary);border-color:var(--primary);color:var(--onp);font-weight:600}
.chk{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);border-radius:999px;padding:7px 12px;background:var(--bg);font-size:14px}
.chk input{width:18px;height:18px;accent-color:var(--primary)}
.chiprow.wrap{margin-top:10px}
.chiprow.eight{display:grid;grid-template-columns:repeat(8,1fr);gap:4px}
.chiprow.eight .chip{min-width:0;padding:8px 0}

/* weigh-in */
.weighrow{display:flex;align-items:flex-end;gap:10px}
.biginp{width:140px;font-size:44px;font-weight:800;letter-spacing:-.02em;border:0;border-bottom:2px solid var(--line);background:none;padding:0 0 2px;border-radius:0;min-height:54px}
.biginp:focus{outline:none;border-bottom-color:var(--primary)}
.unit{color:var(--muted);font-weight:600;padding-bottom:8px}
.wmeta{margin-left:auto;text-align:right;display:flex;flex-direction:column;font-size:13px;color:var(--muted)}
.wmeta b{font-size:22px;color:var(--ink);font-weight:700;line-height:1.1}

/* gauges */
.gauge{margin:2px 0 12px}
.gtop{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.gval{font-size:26px;font-weight:800;letter-spacing:-.01em}
.gval small{font-size:14px;font-weight:600;color:var(--muted)}
.gof{font-size:13px;color:var(--muted);text-align:right}
.bar{position:relative;height:10px;background:var(--soft);border-radius:6px;margin-top:6px;overflow:hidden}
.bar i{position:absolute;top:0;bottom:0;display:block}
.bar .zone{background:var(--band)}
.bar .fill{left:0;background:var(--primary);border-radius:6px;opacity:.9;transition:width .25s}
.bar .fill.ok{background:var(--good)}
.bar .fill.over{background:var(--bad)}
.bar .tick{width:2px;background:var(--ink);opacity:.5}
.macros{display:flex;justify-content:space-between;gap:8px;font-size:13.5px;color:var(--muted);border-top:1px solid var(--line);padding-top:8px;margin-bottom:6px}
.macros b{color:var(--ink);font-size:16px}
@media (prefers-reduced-motion:reduce){.bar .fill{transition:none}}

/* entries */
.entries{list-style:none;margin:6px 0 10px;padding:0}
.entries li{display:flex;align-items:center;gap:6px;padding:8px 0;border-top:1px solid var(--line)}
.entries li:first-child{border-top:0}
.en{flex:1;min-width:0}
.enn{display:block;font-weight:600;font-size:15px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.env{display:block;font-size:13px;color:var(--muted)}
.ib{width:38px;height:38px;border-radius:9px;border:1px solid var(--line);background:none;color:var(--muted);flex:none;font-size:15px}
.ib.on{color:var(--hi);border-color:var(--hi)}
.addgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}
.addgrid .span3{grid-column:1/-1}
details.plan-meals{margin-top:12px;border-top:1px solid var(--line);padding-top:10px}
details.plan-meals summary{font-weight:600;cursor:pointer;color:var(--primary)}
.pqa{margin-top:10px}
.pqh{font-weight:700;font-size:14px;margin-bottom:4px}
.pqb{display:flex;width:100%;text-align:left;justify-content:space-between;gap:10px;border:1px solid var(--line);background:var(--bg);border-radius:10px;padding:9px 11px;margin-bottom:6px;font-size:14px}
.pqb em{font-style:normal;color:var(--primary);font-size:12.5px}
.pqb .sub{display:block;font-size:12.5px;color:var(--muted);margin-top:2px}
.pqv{white-space:nowrap;font-weight:700}
.pqv small{font-weight:400;color:var(--muted)}

/* checks */
.check{display:flex;align-items:flex-start;gap:12px;padding:10px 0;border-top:1px solid var(--line);cursor:pointer}
.card h2+.check,.card .hint+.check{border-top:0}
.check input{width:24px;height:24px;flex:none;accent-color:var(--primary);margin:0}
.check .sub{display:block;font-size:13px;color:var(--muted)}
.cl{list-style:none;margin:0;padding:0}
.cl li{display:flex;align-items:center;gap:10px;padding:6px 0;font-size:14.5px;color:var(--muted)}
.cl li i{width:22px;height:22px;border-radius:50%;border:1.5px solid var(--line);display:inline-flex;align-items:center;justify-content:center;font-style:normal;font-size:13px;flex:none}
.cl li.y{color:var(--ink)}
.cl li.y i{background:var(--good);border-color:var(--good);color:var(--onp)}
.cl-score{font-size:14px;color:var(--muted);margin-bottom:4px}
.cl-score b{font-size:22px;color:var(--ink)}
.live-hint{font-size:13px;color:var(--muted);align-self:end;padding-bottom:6px;line-height:1.3}
.live-hint b{color:var(--ink);font-size:16px}

/* train */
.sets{display:flex;flex-direction:column;gap:6px;margin-bottom:8px}
.setrow{display:grid;grid-template-columns:minmax(0,1fr) 54px 54px 64px 38px;gap:5px;align-items:center}
.setrow .inp{padding:9px 7px}
.sethead span{font-size:12px;color:var(--muted);padding-left:4px}
.strip{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.sday{border:1px solid var(--line);background:var(--bg);border-radius:10px;padding:6px 2px;display:flex;flex-direction:column;align-items:center;gap:1px;font-size:11px;min-width:0}
.sday .sd{color:var(--muted)} .sday .sn{font-weight:800;font-size:16px}
.sday .sp{font-size:10.5px;white-space:nowrap} .sday .ss{font-size:10px;color:var(--muted);text-align:center;line-height:1.1}
.sday.sel{outline:2px solid var(--primary);outline-offset:-2px}
.sday.st-done,.sday.st-hard{background:var(--band)}
.sday.st-hard .ss,.sday.st-done .ss{color:var(--good);font-weight:700}
.sday.st-missed .ss{color:var(--bad);font-weight:700}
.gridhead,.grow{display:grid;grid-template-columns:26px repeat(7,1fr);gap:4px;align-items:center}
.gridhead span{font-size:11px;color:var(--muted);text-align:center}
.grow{margin-top:4px}
.grow .gw{font-size:12px;color:var(--muted);text-align:right;padding-right:4px}
.grow.cur .gw{color:var(--primary);font-weight:800}
.gc{height:22px;border-radius:5px;border:1px solid var(--line);background:none;padding:0}
.gc.today{outline:2px solid var(--ink);outline-offset:1px}
.g-hard{background:var(--primary);border-color:var(--primary)}
.g-done{background:var(--good);border-color:var(--good);opacity:.55}
.g-missed{background:var(--bad);border-color:var(--bad);opacity:.8}
.g-unlogged{background:repeating-linear-gradient(45deg,var(--soft) 0 3px,transparent 3px 6px);border-color:var(--bad)}
.g-planned{background:none;border-color:var(--muted)}
.g-rest{background:var(--soft);border-color:var(--soft)}
.legend2{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:12.5px;color:var(--muted);margin:10px 0 6px}
.legend2 span{display:inline-flex;align-items:center;gap:5px}
.legend2 i{display:inline-block;width:14px;height:12px;border-radius:3px;border:1px solid var(--line)}
.legend2 .lg-dot{width:8px;height:8px;border-radius:50%;background:var(--muted);border:0}
.legend2 .lg-avg{height:3px;background:var(--primary);border:0}
.legend2 .lg-proj{height:0;border:0;border-top:2px dashed var(--hi)}
.legend2 .lg-band{background:var(--band);border:0}

/* stats / tables */
.stats3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}
.stat{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:10px}
.stat b{display:block;font-size:24px;font-weight:800;letter-spacing:-.01em}
.stat span{font-size:12.5px;color:var(--muted)}
.tw{overflow-x:auto;-webkit-overflow-scrolling:touch;margin:0 -2px}
.tbl{border-collapse:collapse;width:100%;font-size:14px}
.tbl th,.tbl td{padding:8px 6px;text-align:left;border-bottom:1px solid var(--line);vertical-align:top}
.tbl th{font-size:12.5px;font-weight:600;color:var(--muted);white-space:nowrap}
.tbl .num{text-align:right;white-space:nowrap}
.tbl tr.cur td{background:var(--band)}
.tbl tr.chg td{background:color-mix(in srgb,var(--hi) 18%,transparent)}
.clickrow{cursor:pointer}
table.kv{width:100%;border-collapse:collapse;font-size:14.5px}
table.kv td{padding:8px 2px;border-bottom:1px solid var(--line)}
table.kv td.num{text-align:right}
table.kv small{display:block;color:var(--muted);font-size:12px;font-weight:400}
.suggest{background:var(--bg);border-radius:12px;padding:10px 12px;margin-bottom:10px}
.suggest p{margin:4px 0 0}
.decs{display:flex;flex-direction:column;gap:6px;margin-bottom:8px}
.dec{display:flex;gap:10px;align-items:flex-start;text-align:left;border:1px solid var(--line);background:none;border-radius:11px;padding:10px 12px;font-size:14px}
.dec i{width:18px;height:18px;border-radius:50%;border:2px solid var(--line);flex:none;margin-top:1px}
.dec.on{border-color:var(--primary);background:var(--band)}
.dec.on i{border-color:var(--primary);background:radial-gradient(var(--primary) 45%,transparent 50%)}
.dec em{font-style:normal;font-size:12px;color:var(--primary);font-weight:700}
.bws{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-bottom:8px}
.bw{border:1px solid var(--line);background:var(--bg);border-radius:10px;padding:6px 0;display:flex;flex-direction:column;align-items:center;font-size:12px}
.bw b{font-size:14px}
.bench{border-top:1px solid var(--line);padding-top:6px;margin-top:6px}
.bench:first-of-type{border-top:0}
.tchips{display:flex;flex-wrap:wrap;gap:6px}
.tchips span{background:var(--bg);border-radius:10px;padding:6px 10px;font-size:13.5px}
.tchips b{font-size:15px}
ul.plain{margin:0;padding-left:18px;font-size:14.5px}
ul.plain li{margin:5px 0}
.phase-row{border-top:1px solid var(--line);padding:8px 0 2px}
.phase-row:first-of-type{border-top:0}
.opt{margin-bottom:10px}
.opth{display:flex;justify-content:space-between;gap:8px;font-weight:700;font-size:14.5px;margin:4px 0}
.opth .num{font-weight:600;color:var(--muted);font-size:13px;white-space:nowrap}
.palettes{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.pal{border:1px solid var(--line);background:var(--bg);border-radius:12px;padding:10px 4px 8px;display:flex;flex-wrap:wrap;justify-content:center;gap:3px}
.pal i{width:16px;height:16px;border-radius:50%;border:1px solid rgba(0,0,0,.15)}
.pal span{flex-basis:100%;text-align:center;font-size:13px;margin-top:4px}
.pal.on{border-color:var(--primary);outline:2px solid var(--primary);outline-offset:-2px}

/* chart */
.chart{width:100%;height:auto;display:block}
.c-grid{stroke:var(--line);stroke-width:1}
.c-axis{stroke:var(--muted)}
.c-lab{fill:var(--muted);font-size:10px;font-family:var(--sans)}
.c-lab.sm{font-size:8.5px}
.c-break{fill:var(--soft)}
.c-hol{stroke:var(--bad);stroke-dasharray:2 3;opacity:.55}
.c-band{fill:var(--band)}
.c-proj{fill:none;stroke:var(--hi);stroke-width:1.6;stroke-dasharray:4 3}
.c-today{stroke:var(--ink);opacity:.35}
.c-dot{fill:var(--muted);opacity:.85}
.c-avg{fill:none;stroke:var(--primary);stroke-width:2.6;stroke-linejoin:round;stroke-linecap:round}

/* guide */
details.toc{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:10px 12px;margin-bottom:14px;position:sticky;top:env(safe-area-inset-top,0px);z-index:3;max-height:70vh;overflow:auto}
details.toc summary{font-weight:700;cursor:pointer}
.toc-list{display:flex;flex-direction:column;margin-top:6px}
.toc-i{background:none;border:0;text-align:left;padding:7px 0;font-size:14.5px;border-top:1px solid var(--line)}
.toc-i.major{font-weight:700;color:var(--primary);margin-top:6px}
.guide{font-family:var(--serif);font-size:16.5px;line-height:1.65}
.guide section{padding:4px 0 10px}
.guide section.part{border-top:2px solid var(--ink);margin-top:24px;padding-top:18px}
.guide .part-kicker{font-family:var(--sans);font-weight:700;color:var(--primary);margin:0}
.guide .part-title{font-family:var(--sans);font-size:28px;margin:2px 0 8px}
.guide .lede{color:var(--muted)}
.guide h2{font-family:var(--sans);font-size:21px;margin:28px 0 10px;line-height:1.25}
.guide h2 .n{color:var(--primary);margin-right:.45em}
.guide h3{font-family:var(--sans);font-size:16px;color:var(--primary);margin:20px 0 8px}
.guide.inline section{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:4px 14px 12px;margin-bottom:12px}
.guide.inline h2{margin-top:12px}
.guide sup.cite{font-family:var(--sans);font-size:.66em;line-height:0}
.guide sup.cite a{color:var(--primary);text-decoration:none}
.guide a{color:var(--primary)}
.guide .tw{overflow-x:auto;margin:10px -2px 14px}
.guide table.tbl{font-family:var(--sans);font-size:13.5px;min-width:520px;line-height:1.4}
.guide table.tbl caption{text-align:left;font-weight:600;padding-bottom:6px}
.guide table.tbl tr.total td{border-top:1.5px solid var(--ink);font-weight:600}
.guide table.tbl tr.hl td{background:var(--band)}
.guide .chg{background:color-mix(in srgb,var(--hi) 22%,transparent);padding:0 .15em}
.guide .callout{background:var(--band);border-left:3px solid var(--primary);padding:10px 14px;margin:14px 0;border-radius:0 8px 8px 0}
.guide .callout.warn{border-left-color:var(--bad);background:color-mix(in srgb,var(--bad) 10%,transparent)}
.guide .callout p:last-child{margin-bottom:0}
.guide .eq{background:var(--surface2);border-radius:8px;padding:12px 14px;margin:12px 0;overflow-x:auto}
.guide .eq-line{white-space:nowrap;font-size:16px}
.guide .eq-note{font-family:var(--sans);font-size:13px;color:var(--muted);margin-top:6px}
.guide .opt,.guide .caption{font-family:var(--sans);font-weight:700;margin:12px 0 4px}
.guide .note,.guide .phase-meta,.guide .disclaimer{font-family:var(--sans);font-size:13.5px;color:var(--muted)}
.guide ol.steps,.guide ul.check{font-family:var(--sans);font-size:15px}
.guide ul.check{list-style:none;padding:0}
.guide ul.check li{display:flex;gap:.6em;padding:5px 0;border-bottom:1px solid var(--line)}
.guide .box{display:inline-block;width:.95em;height:.95em;border:1.4px solid var(--muted);border-radius:2px;flex:none;margin-top:.25em}
.guide .two-col{display:grid;grid-template-columns:1fr;gap:0}
.guide ol.refs{font-family:var(--sans);font-size:13px;color:var(--muted);padding-left:2em}
.guide ol.refs li{margin-bottom:6px}
.guide ol.refs li:target{background:var(--band)}

/* tabs */
nav.tabs{position:fixed;left:0;right:0;bottom:0;background:var(--surface);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom,0px);z-index:10}
nav.tabs .in{max-width:600px;margin:0 auto;display:grid;grid-template-columns:repeat(5,1fr)}
nav.tabs button{background:none;border:0;border-top:3px solid transparent;padding:9px 2px 9px;font-size:12.5px;font-weight:600;color:var(--muted);display:flex;flex-direction:column;align-items:center;gap:3px}
nav.tabs svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
nav.tabs button[aria-current="page"]{color:var(--primary);border-top-color:var(--primary)}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(84px + env(safe-area-inset-bottom,0px));background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:10px;font-size:14px;z-index:20;opacity:0;transition:opacity .2s;pointer-events:none;max-width:90vw;text-align:center}
.toast.show{opacity:1}
@media (prefers-reduced-motion:reduce){.toast{transition:none}}
@media (max-width:370px){.target .big{font-size:44px}.setrow{grid-template-columns:1fr 46px 46px 56px 36px}.addgrid{grid-template-columns:1fr 1fr}}

/* estimator + targets */
.seg.mini{margin:4px 0 8px}
.seg.mini button{min-height:36px;padding:7px 4px}
.estout{background:var(--bg);border-radius:10px;padding:10px 12px;margin:10px 0 2px;font-size:14.5px;line-height:1.5;min-height:42px}
.estout b{font-size:17px}
.potrows{display:flex;flex-direction:column;gap:6px;margin-bottom:6px}
.potrow{display:grid;grid-template-columns:minmax(0,1fr) 78px 38px;gap:5px;align-items:center}
.potrow select.inp{font-size:14px;padding-right:24px}
details.nf{margin-top:10px;border-top:1px solid var(--line);padding-top:8px}
details.nf summary{font-weight:600;cursor:pointer;color:var(--primary);font-size:14.5px}
.ttable td{vertical-align:middle;padding:5px 4px;border-bottom:0}
.ttable tr.evrow td{padding:0 4px 8px;font-size:11.5px;color:var(--muted);border-bottom:1px solid var(--line)}
.ttable td small{display:block;font-size:10.5px;color:var(--muted)}
.ttable .wk{font-weight:800;font-size:16px;text-decoration:none}
.tin{width:58px;min-height:38px;padding:6px 5px;border:1px solid var(--line);border-radius:8px;background:var(--bg);font-size:15px;text-align:right}
.tin::placeholder{color:var(--muted);opacity:.8}
.tin.set{border-color:var(--primary);background:var(--band);font-weight:700}
.ib.sm{width:32px;height:32px;font-size:15px}

</style>
</head>
