<div class="tw"><table class="tbl spec"><colgroup><col style="width:17%"/><col style="width:33%"/><col style="width:8.5%"/><col style="width:33%"/><col style="width:8.5%"/></colgroup><thead><tr><th class="">Meal</th><th class="">Training day</th><th class="num">Cal</th><th class="">Rest day</th><th class="num">Cal</th></tr></thead><tbody><tr class=""><td class=""><b>Breakfast</b></td><td class="">3 eggs, 2 slices Ezekiel, 200 g berries, 5 g oil</td><td class="num">510</td><td class="">3 eggs, 1 slice Ezekiel, 200 g berries, 5 g oil</td><td class="num">430</td></tr><tr class=""><td class=""><b>Lunch</b></td><td class="">120 g chicken breast, 180 g rice, 250 g vegetables, 10 g oil</td><td class="num">608</td><td class="">140 g chicken breast, 100 g rice, 250 g vegetables, 10 g oil</td><td class="num">537</td></tr><tr class=""><td class=""><b>Afternoon (3:30-4:00 PM)</b></td><td class="">200 g cottage cheese 2%, 1 apple</td><td class="num">263</td><td class="">45 g whey + 5 g creatine, 1 apple</td><td class="num">275</td></tr><tr class=""><td class=""><b>After CrossFit</b></td><td class="">45 g whey + 5 g creatine</td><td class="num">180</td><td class="">No session</td><td class="num"></td></tr><tr class=""><td class=""><b>Dinner</b></td><td class=""><span class="chg">90 g chicken breast, 125 g rice, 250 g vegetables, 5 g oil</span></td><td class="num">442</td><td class=""><span class="chg">130 g chicken breast, 75 g potato, 250 g vegetables, 10 g oil</span></td><td class="num">455</td></tr><tr class="total"><td class=""><b>Day total</b></td><td class="">P 173 g, C 213 g, F 53 g</td><td class="num"><b>2,003</b></td><td class="">P 160 g, C 146 g, F 54 g</td><td class="num"><b>1,697</b></td></tr></tbody></table></div>
